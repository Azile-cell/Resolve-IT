@model ResolveIT.Web.Models.Ticket
@using ResolveIT.Web.Models

@{
    ViewData["Title"] = "Edit Ticket";
}

<h1>Edit Ticket</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" readonly />
    </div>

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" readonly></textarea>
    </div>

    <div>
        <label asp-for="Priority"></label>
        <select asp-for="Priority"
                asp-items="Html.GetEnumSelectList<TicketPriority>()">
        </select>
    </div>

    <div>
        <label asp-for="Status"></label>
        <select asp-for="Status"
                asp-items="Html.GetEnumSelectList<TicketStatus>()">
        </select>
    </div>

    <button type="submit">Save Changes</button>

    <a asp-action="Index">Cancel</a>
</form>