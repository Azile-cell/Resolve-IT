@model ResolveIT.Web.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<h1>Delete Ticket</h1>

<p>Are you sure you want to delete this ticket?</p>

<dl>
    <dt>Ticket Number</dt>
    <dd>@Model.Id</dd>

    <dt>Title</dt>
    <dd>@Model.Title</dd>

    <dt>Description</dt>
    <dd>@Model.Description</dd>

    <dt>Priority</dt>
    <dd>@Model.Priority</dd>

    <dt>Status</dt>
    <dd>@Model.Status</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit">Delete Ticket</button>

    <a asp-action="Index">Cancel</a>
</form>