@model List<ResolveIT.Web.Models.Ticket>

@{
    ViewData["Title"] = "Support Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Support Tickets</h1>
        <p class="text-muted">
            View and manage submitted IT support requests.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Create New Ticket
    </a>
</div>

<p class="text-muted">
    Total tickets: @Model.Count
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No support tickets have been submitted yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var ticket in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h2 class="h5">
                                @ticket.Title
                            </h2>

                            <span class="badge bg-primary">
                                @ticket.Priority
                            </span>
                        </div>

                        <p class="card-text">
                            @ticket.Description
                        </p>

                        <p>
                            <strong>Status:</strong>

                            <span class="badge bg-secondary">
                                @ticket.Status
                            </span>
                        </p>

                         <p>
                            Created: @(ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm"))
                        </p>
                    </div>

                    <div class="card-footer bg-white">
                        <a asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}